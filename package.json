{
  "name": "betinhos-sistema",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "pnpm --filter @betinhos/shell dev",
    "build": "pnpm --filter @betinhos/shell build",
    "wr": "pnpm --filter @betinhos/shell wr",
    "push": "pnpm --filter @betinhos/shell push",
    "sitemap:geral": "pnpm --filter @betinhos/shell sitemap:geral",
    "test": "pnpm -r test",
    "typecheck": "pnpm --filter @betinhos/shell typecheck",
    "push:plugin:financeiro:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File packages/plugins/scripts/push-financeiro-plugin.ps1 -EnvironmentUrl https://org23b93544.crm2.dynamics.com -EnvironmentName dev",
    "push:plugin:documentos:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File packages/plugins/scripts/push-documentos-plugin.ps1 -EnvironmentUrl https://org23b93544.crm2.dynamics.com -EnvironmentName dev",
    "push:plugin:frota:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File packages/plugins/scripts/push-frota-plugin.ps1 -EnvironmentUrl https://org23b93544.crm2.dynamics.com -EnvironmentName dev"
  }
}
