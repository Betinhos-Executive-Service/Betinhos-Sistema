{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://betinhos.example/schemas/ai-schedule-proposal-v1.json",
  "title": "Betinhos AI scheduling proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["intent", "assistantMessage", "question", "confidence", "client", "requester", "passengers", "services", "missingFields", "warnings"],
  "properties": {
    "intent": { "const": "schedule" },
    "assistantMessage": { "type": "string", "maxLength": 1200 },
    "question": { "type": ["string", "null"], "maxLength": 500 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "client": { "$ref": "#/$defs/identity" },
    "requester": { "$ref": "#/$defs/identity" },
    "passengers": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/identity" } },
    "services": { "type": "array", "minItems": 0, "maxItems": 50, "items": { "$ref": "#/$defs/service" } },
    "missingFields": { "type": "array", "items": { "type": "string", "maxLength": 160 } },
    "warnings": { "type": "array", "items": { "type": "string", "maxLength": 500 } }
  },
  "$defs": {
    "identity": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["name", "id", "proposedRegistration"],
      "properties": {
        "name": { "type": "string", "maxLength": 250 },
        "id": { "type": ["string", "null"], "maxLength": 80 },
        "proposedRegistration": { "type": ["object", "null"] }
      }
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value"],
      "properties": {
        "label": { "type": "string", "maxLength": 200 },
        "value": { "type": ["integer", "null"] }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "date", "time", "timezone", "origin", "destination", "serviceType", "vehicleType", "observations"],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 1 },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "time": { "type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" },
        "timezone": { "const": "America/Sao_Paulo" },
        "origin": { "type": "string", "maxLength": 500 },
        "destination": { "type": "string", "maxLength": 500 },
        "serviceType": { "$ref": "#/$defs/choice" },
        "vehicleType": { "$ref": "#/$defs/choice" },
        "passengers": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/identity" } },
        "observations": { "type": "string", "maxLength": 2000 }
      }
    }
  }
}
