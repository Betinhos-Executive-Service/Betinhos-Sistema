{
  "swagger": "2.0",
  "info": {
    "title": "Betinhos DeepSeek",
    "description": "Proxy solution-aware para Structured Output do DeepSeek.",
    "version": "1.0.0"
  },
  "host": "api.deepseek.com",
  "basePath": "/",
  "schemes": ["https"],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "securityDefinitions": {
    "api_key": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "Informe Bearer sk-...; a conexão é armazenada pelo Power Platform."
    }
  },
  "security": [{ "api_key": [] }],
  "paths": {
    "/responses": {
      "post": {
        "operationId": "Responses",
        "summary": "Interpretar solicitação estruturada",
        "description": "Envia uma solicitação para o modelo DeepSeek Responses API.",
        "parameters": [{
          "name": "body",
          "in": "body",
          "required": true,
          "schema": { "$ref": "#/definitions/ResponsesRequest" }
        }],
        "responses": {
          "200": { "description": "Resposta DeepSeek", "schema": { "$ref": "#/definitions/ResponsesResponse" } },
          "400": { "description": "Solicitação inválida" },
          "401": { "description": "Chave inválida" },
          "429": { "description": "Limite de requisições" },
          "500": { "description": "Erro do provedor" }
        }
      }
    }
  },
  "definitions": {
    "ResponsesRequest": {
      "type": "object",
      "required": ["model", "input"],
      "properties": {
        "model": { "type": "string", "default": "deepseek-v4-flash" },
        "instructions": { "type": "string" },
        "input": { "type": "string" },
        "thinking": { "type": "object", "properties": { "type": { "type": "string", "default": "disabled" } } },
        "reasoning": { "type": "object", "properties": { "effort": { "type": "string", "default": "none" } } },
        "text": { "type": "object", "additionalProperties": true },
        "max_output_tokens": { "type": "integer", "default": 2200 },
        "stream": { "type": "boolean", "default": false },
        "store": { "type": "boolean", "default": false },
        "response_format": { "type": "object" }
      }
    },
    "ResponsesResponse": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "output": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "usage": { "type": "object", "additionalProperties": true }
      }
    }
  }
}
