{
  "name": "@betinhos/motoristas",
  "version": "2.1.879",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-server.cjs",
    "build": "node scripts/build-react-singlefile.cjs",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "deploy:webresource": "powershell -ExecutionPolicy Bypass -File scripts/deploy-webresource.ps1",
    "check:hygiene": "node --test --experimental-strip-types tests/repositoryHygiene.test.ts",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "preview": "node scripts/serve-dist.cjs",
    "demo:capture": "node scripts/capture-demo-screens.cjs",
    "demo:render": "remotion render remotion/index.ts AppMotoristasDemo remotion-output/app-motoristas-demo.mp4",
    "demo:video": "pnpm demo:capture && pnpm demo:render"
  },
  "dependencies": {
    "@betinhos-executive-service/ui": "1.18.0",
    "chart.js": "4.4.1",
    "chartjs-plugin-datalabels": "2.2.0",
    "lucide-react": "0.468.0",
    "motion": "12.40.0",
    "pdf-lib": "1.17.1",
    "qrcode-generator": "2.0.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.474",
    "@types/react": "18.3.30",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "esbuild": "0.21.5",
    "remotion": "4.0.474",
    "typescript": "5.9.3",
    "vite": "5.4.21"
  }
}
