{
  // Projeto Pages do portal (cliente.betinhos.com.br por CNAME na Locaweb, a zona não está na Cloudflare).
  // Serve o build do app (../dist, SPA) e repassa /api/* ao Worker por service binding (functions/api/[[path]].ts).
  // Produção (branch main do Pages) fala com o Worker portal-cliente (Dataverse PROD); preview (ex.: --branch dev) com portal-cliente-dev.
  "name": "portal-cliente",
  "pages_build_output_dir": "../dist",
  "compatibility_date": "2026-09-01",
  "services": [{ "binding": "API", "service": "portal-cliente" }],
  "env": {
    "preview": {
      "services": [{ "binding": "API", "service": "portal-cliente-dev" }]
    }
  }
}
