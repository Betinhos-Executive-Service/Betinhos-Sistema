{
  // Projeto Pages do portal (cliente.betinhos.com.br por CNAME na Locaweb, a zona não está na Cloudflare).
  // Serve o build do app (../dist, SPA) e repassa /api/* ao Worker por service binding (functions/api/[[path]].ts).
  // Piloto (decisão do Renan, 24/11/2026): a produção (branch main do Pages, cliente.betinhos.com.br) fala com o portal-cliente-dev
  // (Dataverse DEV) até o PROD ficar pronto; aí volta para o portal-cliente. Preview (ex.: --branch dev) também usa o portal-cliente-dev.
  "name": "portal-cliente",
  "pages_build_output_dir": "../dist",
  "compatibility_date": "2026-09-01",
  "services": [{ "binding": "API", "service": "portal-cliente-dev" }],
  "env": {
    "preview": {
      "services": [{ "binding": "API", "service": "portal-cliente-dev" }]
    }
  }
}
