{
  "name": "backups-betinhos",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-26",
  "account_id": "a26e65df1496d9808e12a495bc47cd80",
  "workers_dev": true,
  // Sem URL de pré-visualização: o Cloudflare Access protege só o endereço workers.dev.
  "preview_urls": false,
  // O Worker lista e baixa as cópias e só grava em registros/downloads/; quem grava e apaga cópias é o job r2 do backup-prod.yml.
  // Fontes e logo do Design System (servidos pela borda, atrás do mesmo Access).
  "assets": { "directory": "./public" },
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "betinhos-backup-prod" }],
  // Registro de quem baixou o quê (LGPD), em Workers Logs.
  "observability": { "enabled": true, "traces": { "enabled": true } }
  // Secrets (wrangler secret put): ACCESS_EQUIPE (nome da equipe do Zero Trust, <equipe>.cloudflareaccess.com) e
  // ACCESS_AUD (Application Audience do app do Access). Sem os dois, a página recusa todo mundo.
}
