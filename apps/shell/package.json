    "wr": "pnpm build",
    "test": "vitest run",
    "push": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../../packages/deploy/push-dev.ps1 -AppDir apps/shell -ResourceName cr40f_SistemaBetinhos.html -DisplayName \"Sistema Betinhos\" -LoaderName cr40f_SistemaBetinhosLoader.html -DeviceCode -Build",
    "sitemap:geral": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../../packages/deploy/sitemap-dev.ps1 -SiteMapUniqueName cr40f_ModelDrivenBetinhos -AfterSubAreaId subarea_a5c599b3 -SubAreaId subarea_geral_novo -Title \"Geral (novo)\" -Url \"$webresource:cr40f_SistemaBetinhosLoader.html?data=geral\" -DeviceCode"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.26.0",
