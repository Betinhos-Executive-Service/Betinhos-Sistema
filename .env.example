# Copie para .env (ignorado pelo git) e preencha.
# URL do ambiente Dataverse de DEV, ex.: https://suaorg.crm2.dynamics.com
DV_ENVIRONMENT_URL=
# Hosts em que o push é proibido (PROD), separados por vírgula.
DV_BLOCKED_HOSTS=
# Client ID público usado no login MSAL (app registration com permissão Dataverse user_impersonation).
DV_CLIENT_ID=
# Somente CI (GitHub Actions): service principal. Localmente deixe vazio para usar o login MSAL.
DV_TENANT_ID=
DV_CLIENT_SECRET=
# Solução que recebe os WebResources.
DV_SOLUTION=AppBetinhos

# Plugin de acesso de motoristas: configuracao nao segura lida por push-acesso-plugin.ps1.
# Sem segredo: o clientSecret e digitado em provision-acesso.ps1.
ACESSO_TENANT_ID=
ACESSO_CLIENT_ID=
ACESSO_LICENSE_SKU_ID=
ACESSO_GROUP_ID=
ACESSO_APP_URL=
