{
  "triggers": {
    "When_participation_is_queued": {
      "inputs": {
        "host": {
          "operationId": "SubscribeWebhookTrigger",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
          "connectionName": "shared_commondataserviceforapps"
        },
        "parameters": {
          "subscriptionRequest/message": 3,
          "subscriptionRequest/filterexpression": "cr40f_pushstatus eq 100000000",
          "subscriptionRequest/filteringattributes": "cr40f_pushstatus",
          "subscriptionRequest/entityname": "cr40f_treinamentoparticipacao",
          "subscriptionRequest/scope": 4
        },
        "authentication": "@parameters('$authentication')"
      },
      "type": "OpenApiConnectionWebhook"
    }
  },
  "actions": {
    "Init_web_push_entregue": {
      "runAfter": {},
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "Web_Push_Entregue",
            "type": "boolean",
            "value": false
          }
        ]
      }
    },
    "Mark_lookup_failed": {
      "runAfter": {
        "Get_treinamento": [
          "Failed",
          "TimedOut"
        ]
      },
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "operationId": "UpdateRecord",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
          "connectionName": "shared_commondataserviceforapps"
        },
        "parameters": {
          "entityName": "cr40f_treinamentoparticipacaos",
          "item/cr40f_pushstatus": 100000002,
          "item/cr40f_pusherro": "Nao foi possivel localizar o motorista ou o treinamento.",
          "recordId": "@triggerOutputs()?['body/cr40f_treinamentoparticipacaoid']"
        },
        "authentication": "@parameters('$authentication')"
      }
    },
    "Get_funcionario": {
      "runAfter": {
        "Init_modulo_desligado": [
          "Succeeded"
        ]
      },
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "operationId": "GetItem",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
          "connectionName": "shared_commondataserviceforapps"
        },
        "parameters": {
          "entityName": "cr40f_funcionarioses",
          "$select": "cr40f_emailmicrosoft",
          "recordId": "@triggerOutputs()?['body/_cr40f_funcionario_value']"
        },
        "authentication": "@parameters('$authentication')"
      }
    },
    "Get_treinamento": {
      "runAfter": {
        "Get_funcionario": [
          "Succeeded"
        ]
      },
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "operationId": "GetItem",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
          "connectionName": "shared_commondataserviceforapps"
        },
        "parameters": {
          "entityName": "cr40f_treinamentos",
          "$select": "cr40f_name",
          "recordId": "@triggerOutputs()?['body/_cr40f_treinamento_value']"
        },
        "authentication": "@parameters('$authentication')"
      }
    },
    "Mark_driver_failed": {
      "runAfter": {
        "Get_funcionario": [
          "Failed",
          "TimedOut"
        ]
      },
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "operationId": "UpdateRecord",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
          "connectionName": "shared_commondataserviceforapps"
        },
        "parameters": {
          "entityName": "cr40f_treinamentoparticipacaos",
          "item/cr40f_pushstatus": 100000002,
          "item/cr40f_pusherro": "Nao foi possivel localizar o e-mail do motorista.",
          "recordId": "@triggerOutputs()?['body/cr40f_treinamentoparticipacaoid']"
        },
        "authentication": "@parameters('$authentication')"
      }
    },
    "Init_modulo_desligado": {
      "runAfter": {
        "Init_web_push_entregue": [
          "Succeeded"
        ]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "Modulo_Desligado",
            "type": "boolean",
            "value": false
          }
        ]
      }
    },
    "Config_App": {
      "runAfter": {
        "Get_treinamento": [
          "Succeeded"
        ]
      },
      "type": "Scope",
      "actions": {
        "Config_efetiva": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "operationId": "PerformUnboundAction",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "connectionName": "shared_commondataserviceforapps"
            },
            "parameters": {
              "actionName": "cr40f_AppConfigEfetiva",
              "item/Funcionario": "@triggerOutputs()?['body/_cr40f_funcionario_value']"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Set_modulo_desligado": {
          "runAfter": {
            "Config_efetiva": [
              "Succeeded"
            ]
          },
          "type": "SetVariable",
          "inputs": {
            "name": "Modulo_Desligado",
            "value": "@equals(json(coalesce(outputs('Config_efetiva')?['body/Resultado'], '{}'))?['chaves']?['treinamentos'], false)"
          }
        }
      }
    },
    "Se_modulo_ligado": {
      "actions": {
        "Web_Push_Send_push": {
          "actions": {
            "List_subs_Send_push": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "operationId": "ListRecords",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "connectionName": "shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "new_inscricaopushmotoristas",
                  "$top": 50,
                  "$filter": "_new_funcionario_value eq @{triggerOutputs()?['body/_cr40f_funcionario_value']}",
                  "$select": "new_inscricaopushmotoristaid,new_endpoint,new_chavep256dh,new_chaveauth"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Has_subs_Send_push": {
              "actions": {
                "Select_subs_Send_push": {
                  "runAfter": {},
                  "type": "Select",
                  "inputs": {
                    "from": "@outputs('List_subs_Send_push')?['body/value']",
                    "select": {
                      "endpoint": "@item()?['new_endpoint']",
                      "p256dh": "@item()?['new_chavep256dh']",
                      "auth": "@item()?['new_chaveauth']"
                    }
                  }
                },
                "Worker_Send_push": {
                  "runAfter": {
                    "Select_subs_Send_push": [
                      "Succeeded"
                    ]
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "operationId": "EnviarPush",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_new-5fapp-20motoristas-20web-20push-5f30e351431b40001e",
                      "connectionName": "shared_new-5fapp-20motoristas-20web-20push-5f30e351431b40001e"
                    },
                    "parameters": {
                      "body/payload/tag": "cr40f_treinamentoparticipacao-@{triggerOutputs()?['body/cr40f_treinamentoparticipacaoid']}",
                      "body/payload/body": "Novo treinamento: @{outputs('Get_treinamento')?['body/cr40f_name']}",
                      "body/payload/title": "App Motoristas",
                      "body/subscriptions": "@body('Select_subs_Send_push')",
                      "body/payload/url": "/WebResources/new_app-motoristas-v2?treinamentoParticipacaoId=@{triggerOutputs()?['body/cr40f_treinamentoparticipacaoid']}"
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                },
                "Filter_ok_Send_push": {
                  "runAfter": {
                    "Worker_Send_push": [
                      "Succeeded"
                    ]
                  },
                  "type": "Query",
                  "inputs": {
                    "where": "@and(greaterOrEquals(item()?['status'], 200), less(item()?['status'], 300))",
                    "from": "@outputs('Worker_Send_push')?['body/results']"
                  }
                },
                "Set_web_push_entregue": {
                  "runAfter": {
                    "Filter_ok_Send_push": [
                      "Succeeded"
                    ]
                  },
                  "type": "SetVariable",
                  "inputs": {
                    "name": "Web_Push_Entregue",
                    "value": "@greater(length(body('Filter_ok_Send_push')), 0)"
                  }
                },
                "Filter_gone_Send_push": {
                  "runAfter": {
                    "Worker_Send_push": [
                      "Succeeded"
                    ]
                  },
                  "type": "Query",
                  "inputs": {
                    "where": "@equals(item()?['gone'], true)",
                    "from": "@outputs('Worker_Send_push')?['body/results']"
                  }
                },
                "Select_gone_Send_push": {
                  "runAfter": {
                    "Filter_gone_Send_push": [
                      "Succeeded"
                    ]
                  },
                  "type": "Select",
                  "inputs": {
                    "select": "@item()?['endpoint']",
                    "from": "@body('Filter_gone_Send_push')"
                  }
                },
                "Filter_subs_Send_push": {
                  "runAfter": {
                    "Select_gone_Send_push": [
                      "Succeeded"
                    ]
                  },
                  "type": "Query",
                  "inputs": {
                    "where": "@contains(body('Select_gone_Send_push'), item()?['new_endpoint'])",
                    "from": "@outputs('List_subs_Send_push')?['body/value']"
                  }
                },
                "Delete_each_Send_push": {
                  "foreach": "@body('Filter_subs_Send_push')",
                  "actions": {
                    "Delete_row_Send_push": {
                      "runAfter": {},
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "operationId": "DeleteRecord",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                          "connectionName": "shared_commondataserviceforapps"
                        },
                        "parameters": {
                          "recordId": "@items('Delete_each_Send_push')?['new_inscricaopushmotoristaid']",
                          "entityName": "new_inscricaopushmotoristas"
                        },
                        "authentication": "@parameters('$authentication')"
                      }
                    }
                  },
                  "runAfter": {
                    "Filter_subs_Send_push": [
                      "Succeeded"
                    ]
                  },
                  "type": "Foreach"
                }
              },
              "runAfter": {
                "List_subs_Send_push": [
                  "Succeeded"
                ]
              },
              "expression": {
                "greater": [
                  "@length(outputs('List_subs_Send_push')?['body/value'])",
                  0
                ]
              },
              "type": "If"
            }
          },
          "runAfter": {},
          "type": "Scope"
        },
        "Fallback_V2": {
          "actions": {
            "Send_push": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "operationId": "SendPushNotificationV2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_powerappsnotificationv2",
                  "connectionName": "shared_powerappsnotificationv2-1"
                },
                "parameters": {
                  "payload/dynamicParams/entityLogicalName": "cr40f_treinamentoparticipacao",
                  "payload/message": "Novo treinamento: @{outputs('Get_treinamento')?['body/cr40f_name']}",
                  "payload/playerType": "PowerApps",
                  "payload/app": "{\"type\":\"AppModule\",\"displayName\":\"App Motoristas v2\",\"appIdentifier\":\"new_AppMotoristasv2\"}",
                  "payload/dynamicParams/recordId": "@triggerOutputs()?['body/cr40f_treinamentoparticipacaoid']",
                  "payload/openApp": true,
                  "payload/recipients": [
                    "@outputs('Get_funcionario')?['body/cr40f_emailmicrosoft']"
                  ]
                },
                "authentication": "@parameters('$authentication')"
              }
            }
          },
          "runAfter": {
            "Web_Push_Send_push": [
              "Succeeded",
              "Failed",
              "TimedOut"
            ]
          },
          "else": {
            "actions": {}
          },
          "expression": {
            "equals": [
              "@variables('Web_Push_Entregue')",
              false
            ]
          },
          "type": "If"
        },
        "Mark_sent": {
          "runAfter": {
            "Fallback_V2": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "operationId": "UpdateRecord",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "connectionName": "shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "cr40f_treinamentoparticipacaos",
              "item/cr40f_pushstatus": 100000001,
              "item/cr40f_pusherro": "",
              "recordId": "@triggerOutputs()?['body/cr40f_treinamentoparticipacaoid']"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Mark_failed": {
          "runAfter": {
            "Fallback_V2": [
              "Failed",
              "TimedOut"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "operationId": "UpdateRecord",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "connectionName": "shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "cr40f_treinamentoparticipacaos",
              "item/cr40f_pushstatus": 100000002,
              "item/cr40f_pusherro": "@{actions('Send_push')?['error']?['message']}",
              "recordId": "@triggerOutputs()?['body/cr40f_treinamentoparticipacaoid']"
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      },
      "runAfter": {
        "Config_App": [
          "Succeeded",
          "Failed",
          "TimedOut"
        ]
      },
      "else": {
        "actions": {
          "Mark_modulo_desligado": {
            "runAfter": {},
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "operationId": "UpdateRecord",
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                "connectionName": "shared_commondataserviceforapps"
              },
              "parameters": {
                "entityName": "cr40f_treinamentoparticipacaos",
                "item/cr40f_pushstatus": 100000002,
                "item/cr40f_pusherro": "Push não enviado: o módulo Treinamentos está desligado no App deste motorista.",
                "recordId": "@triggerOutputs()?['body/cr40f_treinamentoparticipacaoid']"
              },
              "authentication": "@parameters('$authentication')"
            }
          }
        }
      },
      "expression": {
        "equals": [
          "@variables('Modulo_Desligado')",
          false
        ]
      },
      "type": "If"
    }
  },
  "contentVersion": "1.0.0.0",
  "outputs": {},
  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    },
    "$authentication": {
      "defaultValue": {},
      "type": "SecureObject"
    }
  },
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#"
}
