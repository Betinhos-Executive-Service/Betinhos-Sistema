{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    },
    "$authentication": {
      "defaultValue": {},
      "type": "SecureObject"
    }
  },
  "triggers": {
    "Todo_dia_05h": {
      "type": "Recurrence",
      "recurrence": {
        "frequency": "Day",
        "interval": 1,
        "timeZone": "E. South America Standard Time",
        "schedule": {
          "hours": [
            "5"
          ],
          "minutes": [
            0
          ]
        }
      }
    }
  },
  "actions": {
    "Sincronizar_notas": {
      "type": "OpenApiConnection",
      "runAfter": {},
      "inputs": {
        "host": {
          "operationId": "PerformUnboundAction",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
          "connectionName": "shared_commondataserviceforapps"
        },
        "parameters": {
          "actionName": "new_SincronizarNotasInfleet"
        },
        "authentication": "@parameters('$authentication')"
      }
    },
    "Resumo": {
      "type": "Compose",
      "runAfter": {
        "Sincronizar_notas": [
          "Succeeded",
          "Failed",
          "TimedOut"
        ]
      },
      "inputs": "@json(coalesce(outputs('Sincronizar_notas')?['body/new_Result'], '{}'))"
    },
    "Alertar": {
      "type": "If",
      "runAfter": {
        "Resumo": [
          "Succeeded",
          "Failed",
          "TimedOut"
        ]
      },
      "expression": {
        "or": [
          {
            "not": {
              "equals": [
                "@actions('Sincronizar_notas')?['status']",
                "Succeeded"
              ]
            }
          },
          {
            "greater": [
              "@length(coalesce(outputs('Resumo')?['falhas'], json('[]')))",
              0
            ]
          },
          {
            "equals": [
              "@outputs('Resumo')?['incompleto']",
              true
            ]
          }
        ]
      },
      "actions": {
        "Enviar_alerta": {
          "type": "OpenApiConnection",
          "runAfter": {},
          "inputs": {
            "host": {
              "operationId": "SendEmailV2",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
              "connectionName": "shared_office365"
            },
            "parameters": {
              "emailMessage/To": "__DESTINATARIOS__",
              "emailMessage/Subject": "[Infleet] Notas dos motoristas não sincronizaram por completo",
              "emailMessage/Body": "<p>A sincronização diária das notas da Infleet (<b>Infleet - Sincronizar notas dos motoristas</b>) não terminou por completo no ambiente @{workflow()?['tags']?['environmentName']}.</p><p>Resumo: @{outputs('Resumo')}</p><p>Erro: @{coalesce(outputs('Sincronizar_notas')?['body']?['error']?['message'], 'sem mensagem')}</p><p>Rodada incompleta ou com falha de motorista não apaga nada: a próxima rodada das 05:00 regrava os últimos dias.</p>",
              "emailMessage/Importance": "High"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Manter_falha": {
          "type": "Terminate",
          "runAfter": {
            "Enviar_alerta": [
              "Succeeded",
              "Failed",
              "TimedOut"
            ]
          },
          "inputs": {
            "runStatus": "Failed",
            "runError": {
              "code": "SincronizacaoIncompleta",
              "message": "Sincronizar_notas falhou, ficou incompleta ou teve falha de motorista; veja o Resumo."
            }
          }
        }
      },
      "else": {
        "actions": {}
      }
    }
  }
}
