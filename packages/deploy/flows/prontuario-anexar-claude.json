{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$authentication": { "defaultValue": {}, "type": "SecureObject" },
    "$connections": { "defaultValue": {}, "type": "Object" }
  },
  "triggers": {
    "manual": {
      "type": "Request",
      "kind": "Http",
      "inputs": {
        "method": "POST",
        "triggerAuthenticationType": "All",
        "schema": {
          "type": "object",
          "properties": {
            "liberacaoId": { "type": "string" },
            "token": { "type": "string" },
            "titulo": { "type": "string" },
            "texto": { "type": "string" },
            "arquivos": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "nome": { "type": "string" },
                  "mimeType": { "type": "string" },
                  "conteudoBase64": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  },
  "actions": {
    "Iniciar_status": {
      "type": "InitializeVariable",
      "runAfter": {},
      "inputs": { "variables": [{ "name": "httpStatus", "type": "integer", "value": 500 }] }
    },
    "Iniciar_corpo": {
      "type": "InitializeVariable",
      "runAfter": { "Iniciar_status": ["Succeeded"] },
      "inputs": { "variables": [{ "name": "corpo", "type": "object", "value": { "sucesso": false, "erro": "Não foi possível anexar agora. Nada foi salvo; peça uma nova liberação ao Claude e tente de novo." } }] }
    },
    "Iniciar_enviados": {
      "type": "InitializeVariable",
      "runAfter": { "Iniciar_corpo": ["Succeeded"] },
      "inputs": { "variables": [{ "name": "enviados", "type": "array", "value": [] }] }
    },
    "Iniciar_links": {
      "type": "InitializeVariable",
      "runAfter": { "Iniciar_enviados": ["Succeeded"] },
      "inputs": { "variables": [{ "name": "links", "type": "string", "value": "" }] }
    },
    "Try": {
      "type": "Scope",
      "runAfter": { "Iniciar_links": ["Succeeded"] },
      "actions": {
        "Tamanhos": {
          "type": "Select",
          "runAfter": {},
          "inputs": {
            "from": "@coalesce(triggerBody()?['arquivos'], json('[]'))",
            "select": {
              "nome": "@{item()?['nome']}",
              "mimeType": "@{item()?['mimeType']}",
              "tamanho": "@sub(div(mul(length(coalesce(item()?['conteudoBase64'], '')), 3), 4), if(endsWith(coalesce(item()?['conteudoBase64'], ''), '=='), 2, if(endsWith(coalesce(item()?['conteudoBase64'], ''), '='), 1, 0)))"
            }
          }
        },
        "Consumir": {
          "type": "OpenApiConnection",
          "runAfter": { "Tamanhos": ["Succeeded"] },
          "inputs": {
            "host": { "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps", "connectionName": "shared_commondataserviceforapps", "operationId": "PerformUnboundAction" },
            "parameters": {
              "actionName": "cr40f_ConsumirAnexoProntuario",
              "item/LiberacaoId": "@{coalesce(triggerBody()?['liberacaoId'], '')}",
              "item/Token": "@{coalesce(triggerBody()?['token'], '')}",
              "item/ArquivosJson": "@{string(body('Tamanhos'))}",
              "item/Titulo": "@{coalesce(triggerBody()?['titulo'], '')}",
              "item/Texto": "@{coalesce(triggerBody()?['texto'], '')}"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Liberado": {
          "type": "If",
          "runAfter": { "Consumir": ["Succeeded"] },
          "expression": { "and": [{ "equals": ["@outputs('Consumir')?['body/Ok']", true] }] },
          "actions": {
            "Finais": {
              "type": "Compose",
              "runAfter": {},
              "inputs": "@json(outputs('Consumir')?['body/ArquivosJson'])"
            },
            "Salvar_cada": {
              "type": "Foreach",
              "foreach": "@range(0, length(outputs('Finais')))",
              "runAfter": { "Finais": ["Succeeded"] },
              "runtimeConfiguration": { "concurrency": { "repetitions": 1 } },
              "actions": {
                "Arquivo": {
                  "type": "Compose",
                  "runAfter": {},
                  "inputs": "@outputs('Finais')[items('Salvar_cada')]"
                },
                "Criar_arquivo": {
                  "type": "OpenApiConnection",
                  "runAfter": { "Arquivo": ["Succeeded"] },
                  "inputs": {
                    "host": { "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline", "connectionName": "shared_sharepointonline", "operationId": "CreateFile" },
                    "parameters": {
                      "dataset": "__SITE_URL__",
                      "folderPath": "@{concat('/Documentos Compartilhados/', outputs('Consumir')?['body/Pasta'])}",
                      "name": "@{outputs('Arquivo')?['nome']}",
                      "body": "@base64ToBinary(triggerBody()?['arquivos'][items('Salvar_cada')]?['conteudoBase64'])"
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                },
                "Guardar_enviado": {
                  "type": "AppendToArrayVariable",
                  "runAfter": { "Criar_arquivo": ["Succeeded"] },
                  "inputs": { "name": "enviados", "value": { "id": "@{body('Criar_arquivo')?['Id']}" } }
                },
                "Campos": {
                  "type": "Compose",
                  "runAfter": { "Guardar_enviado": ["Succeeded"] },
                  "inputs": {
                    "href": "@{concat('__SITE_URL__', replace(uriComponent(coalesce(body('Criar_arquivo')?['Path'], '')), '%2F', '/'))}",
                    "caminho": "@{replace(replace(replace(replace(coalesce(body('Criar_arquivo')?['Path'], ''), '&', '&amp;'), '<', '&lt;'), '>', '&gt;'), '\"', '&quot;')}",
                    "id": "@{replace(replace(replace(replace(coalesce(body('Criar_arquivo')?['Id'], ''), '&', '&amp;'), '<', '&lt;'), '>', '&gt;'), '\"', '&quot;')}",
                    "nome": "@{replace(replace(replace(replace(coalesce(outputs('Arquivo')?['nome'], ''), '&', '&amp;'), '<', '&lt;'), '>', '&gt;'), '\"', '&quot;')}"
                  }
                },
                "Acrescentar_link": {
                  "type": "AppendToStringVariable",
                  "runAfter": { "Campos": ["Succeeded"] },
                  "inputs": {
                    "name": "links",
                    "value": "<p style=\"margin: 0;\" data-sp-anexo=\"true\"><a href=\"@{outputs('Campos')?['href']}\" data-sp-path=\"@{outputs('Campos')?['caminho']}\" data-sp-id=\"@{outputs('Campos')?['id']}\" data-sp-mime=\"@{outputs('Arquivo')?['mimeType']}\" data-sp-size=\"@{outputs('Arquivo')?['tamanho']}\">Anexo no SharePoint: @{outputs('Campos')?['nome']}</a></p>"
                  }
                }
              }
            },
            "Criar_nota": {
              "type": "OpenApiConnection",
              "runAfter": { "Salvar_cada": ["Succeeded"] },
              "inputs": {
                "host": { "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps", "connectionName": "shared_commondataserviceforapps", "operationId": "CreateRecord" },
                "parameters": {
                  "entityName": "annotations",
                  "item/subject": "@{outputs('Consumir')?['body/Titulo']}",
                  "item/notetext": "<div class=\"ck-content\" data-wrapper=\"true\" dir=\"ltr\" style=\"--ck-image-style-spacing: 1.5em; --ck-inline-image-style-spacing: calc(var(--ck-image-style-spacing) / 2); font-family: Segoe UI; font-size: 11pt;\">@{outputs('Consumir')?['body/CorpoHtml']}@{variables('links')}</div>",
                  "item/__NAV_ANOTACAO__@odata.bind": "/__SET_FUNCIONARIOS__(@{outputs('Consumir')?['body/FuncionarioId']})"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Sucesso_status": {
              "type": "SetVariable",
              "runAfter": { "Criar_nota": ["Succeeded"] },
              "inputs": { "name": "httpStatus", "value": 200 }
            },
            "Sucesso_corpo": {
              "type": "SetVariable",
              "runAfter": { "Sucesso_status": ["Succeeded"] },
              "inputs": { "name": "corpo", "value": { "sucesso": true, "annotationId": "@{body('Criar_nota')?['annotationid']}", "arquivos": "@length(variables('enviados'))" } }
            }
          },
          "else": {
            "actions": {
              "Recusar_status": {
                "type": "SetVariable",
                "runAfter": {},
                "inputs": { "name": "httpStatus", "value": "@if(equals(outputs('Consumir')?['body/Codigo'], 'ARQUIVOS'), 400, 403)" }
              },
              "Recusar_corpo": {
                "type": "SetVariable",
                "runAfter": { "Recusar_status": ["Succeeded"] },
                "inputs": { "name": "corpo", "value": { "sucesso": false, "erro": "@{outputs('Consumir')?['body/Erro']}" } }
              }
            }
          }
        }
      }
    },
    "Catch": {
      "type": "Scope",
      "runAfter": { "Try": ["Failed", "TimedOut"] },
      "actions": {
        "Limpar": {
          "type": "Foreach",
          "foreach": "@variables('enviados')",
          "runAfter": {},
          "runtimeConfiguration": { "concurrency": { "repetitions": 1 } },
          "actions": {
            "Apagar_arquivo": {
              "type": "OpenApiConnection",
              "runAfter": {},
              "inputs": {
                "host": { "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline", "connectionName": "shared_sharepointonline", "operationId": "DeleteFile" },
                "parameters": { "dataset": "__SITE_URL__", "id": "@{items('Limpar')?['id']}" },
                "authentication": "@parameters('$authentication')"
              }
            }
          }
        },
        "Erro_status": {
          "type": "SetVariable",
          "runAfter": { "Limpar": ["Succeeded", "Failed", "Skipped", "TimedOut"] },
          "inputs": { "name": "httpStatus", "value": 500 }
        },
        "Erro_corpo": {
          "type": "SetVariable",
          "runAfter": { "Erro_status": ["Succeeded"] },
          "inputs": { "name": "corpo", "value": { "sucesso": false, "erro": "Não foi possível anexar agora. Nada foi salvo; peça uma nova liberação ao Claude e tente de novo." } }
        }
      }
    },
    "Responder": {
      "type": "Response",
      "kind": "Http",
      "runAfter": { "Catch": ["Succeeded", "Failed", "Skipped", "TimedOut"] },
      "inputs": { "statusCode": "@variables('httpStatus')", "headers": { "Content-Type": "application/json" }, "body": "@variables('corpo')" }
    },
    "Falhou": {
      "type": "If",
      "runAfter": { "Responder": ["Succeeded"] },
      "expression": { "and": [{ "greaterOrEquals": ["@variables('httpStatus')", 500] }] },
      "actions": {
        "Marcar_falha": {
          "type": "Terminate",
          "runAfter": {},
          "inputs": { "runStatus": "Failed", "runError": { "code": "AnexoFalhou", "message": "Falha ao anexar no prontuário; arquivos enviados foram apagados." } }
        }
      },
      "else": { "actions": {} }
    }
  }
}
