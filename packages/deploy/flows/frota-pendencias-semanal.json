{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$authentication": { "defaultValue": {}, "type": "SecureObject" },
    "$connections": { "defaultValue": {}, "type": "Object" },
    "URL do Sistema Betinhos (new_URLSistemaBetinhos)": {
      "defaultValue": "",
      "type": "String",
      "metadata": { "schemaName": "new_URLSistemaBetinhos", "description": "Endereço do Sistema Betinhos usado nos links dos e-mails." }
    },
    "E-mail do administrador dos avisos (new_EmailAdminAvisos)": {
      "defaultValue": "",
      "type": "String",
      "metadata": { "schemaName": "new_EmailAdminAvisos", "description": "Recebe o aviso quando o resumo semanal falha." }
    }
  },
  "triggers": {
    "Toda_quarta_8h": {
      "type": "Recurrence",
      "recurrence": {
        "frequency": "Week",
        "interval": 1,
        "timeZone": "E. South America Standard Time",
        "startTime": "2026-10-21T08:00:00",
        "schedule": { "weekDays": ["Wednesday"], "hours": ["8"], "minutes": [0] }
      }
    }
  },
  "actions": {
    "Try": {
      "type": "Scope",
      "runAfter": {},
      "actions": {
        "Pendencias": {
          "type": "OpenApiConnection",
          "runAfter": {},
          "inputs": {
            "host": { "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps", "connectionName": "shared_commondataserviceforapps", "operationId": "PerformUnboundAction" },
            "parameters": { "actionName": "cr40f_FrotaPendencias" },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Dados": {
          "type": "Compose",
          "runAfter": { "Pendencias": ["Succeeded"] },
          "inputs": "@json(outputs('Pendencias')?['body/PendenciasJson'])"
        },
        "Tem_pendencias": {
          "type": "If",
          "runAfter": { "Dados": ["Succeeded"] },
          "expression": { "and": [ { "greater": [ "@int(outputs('Dados')?['total'])", 0 ] } ] },
          "actions": {
            "Rotulos": {
              "type": "Compose",
              "runAfter": {},
              "inputs": { "prioridade": "Prioridade alta parada", "reincidencia": "Manutenção reincidente", "preventiva": "Preventiva vencida ou a vencer", "agendada": "Agendada e não realizada", "custo": "Custo fora da curva", "hodometro": "Hodômetro desatualizado" }
            },
            "Linhas": {
              "type": "Select",
              "runAfter": { "Rotulos": ["Succeeded"] },
              "inputs": {
                "from": "@outputs('Dados')?['pendencias']",
                "select": "@concat('<tr><td style=\"padding:6px 10px;border-bottom:1px solid #E5E7EB;white-space:nowrap\">', coalesce(outputs('Rotulos')?[item()?['tipo']], item()?['tipo']), '</td><td style=\"padding:6px 10px;border-bottom:1px solid #E5E7EB;white-space:nowrap\">', coalesce(item()?['placa'], '—'), '</td><td style=\"padding:6px 10px;border-bottom:1px solid #E5E7EB\"><b>', coalesce(item()?['titulo'], ''), '</b><br>', coalesce(item()?['detalhe'], ''), '</td></tr>')"
              }
            },
            "Corpo": {
              "type": "Compose",
              "runAfter": { "Linhas": ["Succeeded"] },
              "inputs": "@concat('<div style=\"font-family:Segoe UI,Arial,sans-serif;font-size:14px;color:#1F2937\">', '<p>Pendências da frota em ', formatDateTime(outputs('Dados')?['hoje'], 'dd/MM/yyyy'), ': <b>', string(outputs('Dados')?['total']), '</b>.</p>', '<table style=\"border-collapse:collapse\"><tr><th align=\"left\" style=\"padding:6px 10px;border-bottom:2px solid #D1D5DB\">Tipo</th><th align=\"left\" style=\"padding:6px 10px;border-bottom:2px solid #D1D5DB\">Veículo</th><th align=\"left\" style=\"padding:6px 10px;border-bottom:2px solid #D1D5DB\">Pendência</th></tr>', join(body('Linhas'), ''), '</table>', '<p style=\"margin-top:16px\"><a href=\"', parameters('URL do Sistema Betinhos (new_URLSistemaBetinhos)'), '#/frota\">Abrir as pendências da frota</a> · <a href=\"', parameters('URL do Sistema Betinhos (new_URLSistemaBetinhos)'), '#/assistente-frota\">Ver as propostas do Agente Frota</a></p></div>')"
            },
            "Destinatarios": {
              "type": "OpenApiConnection",
              "runAfter": { "Corpo": ["Succeeded"] },
              "inputs": {
                "host": { "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps", "connectionName": "shared_commondataserviceforapps", "operationId": "ListRecords" },
                "parameters": {
                  "entityName": "cr40f_funcionarioses",
                  "$select": "cr40f_emailbetinhos",
                  "$filter": "statecode eq 0 and cr40f_status eq 0 and new_notificacoesfrota eq true and cr40f_emailbetinhos ne null",
                  "$top": 50
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Enviar": {
              "type": "Foreach",
              "foreach": "@outputs('Destinatarios')?['body/value']",
              "runAfter": { "Destinatarios": ["Succeeded"] },
              "actions": {
                "E_mail": {
                  "type": "OpenApiConnection",
                  "runAfter": {},
                  "inputs": {
                    "host": { "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365", "connectionName": "shared_office365", "operationId": "SendEmailV2" },
                    "parameters": {
                      "emailMessage/From": "__REMETENTE__",
                      "emailMessage/To": "@{trim(items('Enviar')?['cr40f_emailbetinhos'])}",
                      "emailMessage/Subject": "Frota | @{outputs('Dados')?['total']} pendências | @{formatDateTime(outputs('Dados')?['hoje'], 'dd/MM/yyyy')}",
                      "emailMessage/Body": "@{outputs('Corpo')}",
                      "emailMessage/Importance": "Normal"
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                }
              }
            }
          },
          "else": { "actions": {} }
        }
      }
    },
    "Catch": {
      "type": "Scope",
      "runAfter": { "Try": ["Failed", "TimedOut"] },
      "actions": {
        "Falhas": {
          "type": "Query",
          "runAfter": {},
          "inputs": { "from": "@result('Try')", "where": "@not(equals(item()?['status'], 'Succeeded'))" }
        },
        "Avisar_admin": {
          "type": "OpenApiConnection",
          "runAfter": { "Falhas": ["Succeeded"] },
          "inputs": {
            "host": { "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365", "connectionName": "shared_office365", "operationId": "SendEmailV2" },
            "parameters": {
              "emailMessage/From": "__REMETENTE__",
              "emailMessage/To": "@{parameters('E-mail do administrador dos avisos (new_EmailAdminAvisos)')}",
              "emailMessage/Subject": "Frota | Resumo semanal falhou",
              "emailMessage/Body": "@{concat('<p>O resumo semanal da frota falhou na execução ', workflow()?['run']?['name'], '.</p><p>Etapas com problema:</p><pre>', string(body('Falhas')), '</pre>')}",
              "emailMessage/Importance": "High"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Marcar_falha": {
          "type": "Terminate",
          "runAfter": { "Avisar_admin": ["Succeeded", "Failed"] },
          "inputs": { "runStatus": "Failed", "runError": { "code": "ResumoFrotaFalhou", "message": "O resumo semanal da frota falhou; o administrador foi avisado." } }
        }
      }
    }
  },
  "outputs": {}
}
