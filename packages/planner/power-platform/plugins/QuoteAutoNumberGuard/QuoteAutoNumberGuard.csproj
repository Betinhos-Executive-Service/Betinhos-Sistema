<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Betinhos.Planner.AutoNumberGuard</AssemblyName>
    <RootNamespace>Betinhos.Planner.AutoNumberGuard</RootNamespace>
    <Version>1.0.0.0</Version>
    <Deterministic>true</Deterministic>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Betinhos.Planner.AutoNumberGuard.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <Target Name="ValidateStrongNameKey" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(AssemblyOriginatorKeyFile)')" Text="Chave forte ausente: $(AssemblyOriginatorKeyFile)" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.59" PrivateAssets="All" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net462" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>
</Project>
